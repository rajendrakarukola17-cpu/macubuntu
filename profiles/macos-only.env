# Profile: macos-only (Pure Ubuntu -> macOS transformation without Celina AI layer)
ENABLE_CELINA="false"

# UI & Launcher
DOCK_CHOICE="ubuntu-dock"
LAUNCHER_CHOICE="ulauncher"
ENABLE_DESKTOP_ICONS="true"
ENABLE_DYNAMIC_ISLAND_EXT="true"    # Experimental GNOME Shell Dynamic Island extension
TOP_PANEL_STYLE="transparent"       # transparent (zero black line) | hidden (completely remove top bar) | glass
ANIMATION_SPEED="fast"              # fast (0.6x snappy) | normal (1.0x) | instant

# System Tuning
SEARCH_BACKEND="lightweight"        # Switch to 'gnome-indexer' if you have 16GB+ RAM
POWER_BACKEND="ppd"
POINTER_ACCEL="flat"
FONT_AA="rgba"
ENABLE_WAYLAND_FRACTIONAL_SCALING="true"
ENABLE_BATTERY_CHARGE_LIMIT="true"
ENABLE_VAAPI_GPU_DECODE="true"
ENABLE_CLIPBOARD_HISTORY="true"
ENABLE_DYNAMIC_APPEARANCE="false"
ENABLE_SAFARI_FIREFOX="true"
ENABLE_PERSISTENT_CONTINUITY_CAM="true"
ENABLE_PRO_AUDIO_BLUETOOTH="true"
ENABLE_SAFE_SLEEP="true"
ENABLE_SILENT_BOOT="false"

# All-System Continuity & macOS-Parity Hub
ENABLE_AIRPLAY_VIDEO="true"
ENABLE_ANDROID_MIRROR="true"
ENABLE_SYNCTHING="true"
ENABLE_UNIVERSAL_CONTROL="true"
ENABLE_FLATSEAL="true"
ENABLE_KEEPASSXC="true"
ENABLE_NAUTILUS_QUICK_ACTIONS="false" # Celina disabled in macos-only profile
ENABLE_DISTROBOX="false"
ENABLE_BIOMETRICS="false"

# Optional Extras
ENABLE_MACOS_CMD_KEYS="false"
INSTALL_THIRDPARTY="false"
INSTALL_RUST_TOOLS="false"
