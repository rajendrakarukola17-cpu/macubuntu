# ============================================================================
# macubuntu Hardware Profile — 16 GB System RAM (ram_tier=16gb)
# OS kernel tuning, ZRAM, cgroup, and Celina subsystem knobs for 16 GB hosts.
# Sourced by stages via: source "profiles/$(jq -r .ram_tier /etc/macubuntu/hardware.json).env"
# ============================================================================

# ZRAM size expression (evaluated by stage-35 against detected RAM_MB)
# 16 GB: ZRAM = 50% of RAM (~8 GB)
ZRAM_SIZE_EXPR="ram / 2"

# VM sysctl (byte-capped writebacks — no percentage dirty_ratio)
SWAPPINESS=100
VFS_CACHE_PRESSURE=50
DIRTY_BG_BYTES=134217728       # 128 MB
DIRTY_BYTES=402653184          # 384 MB
VM_PAGE_CLUSTER=0
VM_DIRTY_WRITEBACK_CENTISECS=200

# MGLRU working-set protection
MGLRU_MIN_TTL_MS=1000

# vmtouch pinning cap (MB) — GNOME + browser + Celina binaries
VMTOUCH_MAX_MB=512

# celina-ai.slice cgroup ceilings
CELINA_SLICE_HIGH="8500M"
CELINA_SLICE_MAX="10500M"
CELINA_CPU_WEIGHT=50
CELINA_IO_WEIGHT=40

# Blur My Shell / compositor glass settings
BLUR_SIGMA=25
BLUR_APPGRID=true

# llama-server Router Mode preset (see celina/llm/preset_generator.py)
LLM_MODELS_MAX=2
LLM_SLEEP_IDLE_SECONDS=300
LLM_PARALLEL_SLOTS=2
LLM_KV_CACHE_TYPE="q8_0"
LLM_CTX_DEFAULT=16384

# Celina tier policy flags
SERIALIZE_HEAVY_MODELS=false
ENABLE_LADYBUG_GRAPH=true
ENABLE_GLINER_SLOTS=true
KEEP_VOICE_HOT=true
ENABLE_ASTRA_1FPS_BUFFER=false
ENABLE_LIBKRUN_SANDBOX=true
SPOTLIGHT_BATCH_SIZE=8
RAM_PSI_EVICT_THRESHOLD=25.0

# Celina tier-adaptive context compression (16 GB: balanced, ML Kompress opt-in)
CELINA_COMPRESSION_TIER="16gb"
CELINA_HEADROOM_ML="0"
