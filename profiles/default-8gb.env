# Profile: default-8gb (Recommended for 8GB RAM laptops — Ubuntu 26.04 Wayland + Celina AI)
ENABLE_CELINA="true"
CELINA_NAME="Celina"
CELINA_NICKNAME="Celly"

# UI & Launcher
DOCK_CHOICE="ubuntu-dock"
LAUNCHER_CHOICE="celina-spotlight"
ENABLE_DESKTOP_ICONS="true"
ENABLE_DYNAMIC_ISLAND_EXT="false"   # Celina Dynamic Island provides the native top-center pill
TOP_PANEL_STYLE="transparent"       # transparent (zero black line) | hidden (completely remove top bar) | glass
ANIMATION_SPEED="fast"              # fast (0.6x snappy macOS feel) | normal (1.0x) | instant (zero animation)

# System Tuning
SEARCH_BACKEND="lightweight"        # Masks Tracker3/LocalSearch (~400MB saved); uses fd-find + ripgrep
POWER_BACKEND="ppd"                 # Exclusive: ppd OR tlp
POINTER_ACCEL="flat"
FONT_AA="rgba"
ENABLE_WAYLAND_FRACTIONAL_SCALING="true"
ENABLE_BATTERY_CHARGE_LIMIT="true"  # 80% hardware charge threshold where laptop firmware supports it
ENABLE_VAAPI_GPU_DECODE="true"
ENABLE_CLIPBOARD_HISTORY="true"     # macOS Tahoe-style searchable clipboard history
ENABLE_DYNAMIC_APPEARANCE="false"   # Set true (or CELINA_DYNAMIC_APPEARANCE=1) for auto solar Light <-> Dark
ENABLE_SAFARI_FIREFOX="true"        # macOS Safari UI (userChrome/userContent) + Safari compass icon for Firefox
ENABLE_PERSISTENT_CONTINUITY_CAM="true" # Persistent /dev/video10 v4l2loopback module on boot
ENABLE_PRO_AUDIO_BLUETOOTH="true"   # WirePlumber AirPods AAC/LDAC + low-jitter PipeWire clock
ENABLE_SAFE_SLEEP="true"            # macOS Safe Sleep (3h auto-hibernate when swap exists; instant suspend on pure ZRAM)
ENABLE_SILENT_BOOT="false"          # Opt-in flicker-free GRUB boot drop-in + active CPU P-State (--silent-boot)

# All-System Continuity & macOS-Parity Hub (Android, iOS/Mac, Windows, Linux)
ENABLE_AIRPLAY_VIDEO="false"         # UxPlay pinned AirPlay 2 video+audio receiver
ENABLE_ANDROID_MIRROR="false"        # scrcpy + adb 60fps Android mirroring
ENABLE_SYNCTHING="false"             # End-to-end encrypted P2P cross-OS folder sync
ENABLE_UNIVERSAL_CONTROL="false"     # Deskflow cross-OS keyboard/mouse/clipboard KVM
ENABLE_FLATSEAL="true"              # macOS TCC-style Flatpak permission inspector
ENABLE_KEEPASSXC="true"             # Local encrypted Keychain / Passkeys manager
ENABLE_NAUTILUS_QUICK_ACTIONS="true"
ENABLE_DISTROBOX="false"            # Opt-in Linux subsystem containers
ENABLE_BIOMETRICS="false"           # Capability-gated Touch ID / FIDO2 PAM opt-in

# Optional Extras (safe defaults)
ENABLE_MACOS_CMD_KEYS="false"       # Opt-in Wayland terminal-aware Cmd+C/V/Q via keyd (--macos-cmd-keys)
INSTALL_THIRDPARTY="false"
INSTALL_RUST_TOOLS="false"

# Low-Latency Kernel (desktop-tuned, opt-in — requires reboot)
ENABLE_LOW_LATENCY_KERNEL="false"   # false | true (installs XanMod or Liquorix kernel)
LOW_LATENCY_KERNEL_CHOICE="xanmod"  # xanmod | liquorix

# Chrome/Brave Ozone Wayland (opt-in — GPU-accelerated scrolling on Wayland)
ENABLE_CHROME_OZONE_WAYLAND="false" # false | true

# Predictive App Preloading (default-on — pre-caches app binaries into free RAM)
ENABLE_PRELOAD="true"               # true | false (installs preload daemon)

# Snap Removal (default-on — replace Snaps with native .deb / Flatpak)
ENABLE_SNAP_REMOVAL="true"          # true | false (removes snapd + snap packages)

# CPU Mitigations Off (default-on — mitigations=off via GRUB, reboot required)
ENABLE_CPU_MITIGATIONS_OFF="true"   # true | false (5–15% raw speed, security tradeoff)

# Celina AI Slice (default-on — cgroup isolation for Ollama + Celina AI workloads)
ENABLE_CELINA_AI_SLICE="true"       # true | false (systemd slice for AI resource isolation)

# Sched_ext BPF Scheduler (default-on — dynamic CPU scheduling for desktop interactivity)
ENABLE_SCHED_EXT="true"             # true | false (loads scx_bpfland/scx_lavd via scx_loader)

# Btrfs + Snapper APFS-style rollbacks (default-off — destructive filesystem conversion)
ENABLE_BTRFS_SNAPPER="false"        # true | false (btrfs subvolumes + Snapper + GRUB bootable rollback)

# Native Wayland Blur (opt-in — Mutter 51+ ext-background-effect-v1 frosted glass)
ENABLE_NATIVE_WAYLAND_BLUR="false"  # false | true (native compositor-level blur instead of CSS hacks)
ENABLE_EASYEFFECTS="false"          # false | true (PipeWire DSP: Voice Isolation + speaker EQ)
ENABLE_PARENTAL_CONTROLS="false"    # false | true (malcontent app allowlists + session time limits)
ENABLE_DNS_FILTER="false"           # false | true (AdGuard Home local DNS + web filtering)
ENABLE_VOICE_PIPELINE_UPGRADE="false"  # false | true (Kokoro-82M TTS + parakeet-rs ASR + Silero VAD)

# Phase A — MacBook Feel & OS Resilience (v4.6)
ENABLE_S0IX_SLEEP="false"              # false | true (S0ix suspend-then-hibernate on laptops)
ENABLE_HIDPI_FONTS="false"             # false | true (Retina font rendering + XWayland crispness)
ENABLE_WAYLAND_TEXT_INJECTION="false"  # false | true (ydotool/uinput system-wide text injection)
ENABLE_VAULT_AUDIT="false"             # false | true (HIBP k-anonymity breach check)
ENABLE_SELF_HEAL="false"               # false | true (journald crash-loop watcher + recovery pills)

# Phase B — Jarvis Cognitive & Security Architecture (v4.6)
ENABLE_MCP_GUARD="false"               # false | true (OWASP MCP03 tool-poisoning pinning)
ENABLE_BITEMPORAL_KG="false"           # false | true (Bi-temporal knowledge graph + ToM cards)
ENABLE_BLAST_RADIUS="false"            # false | true (Blast-radius estimator + micro-affect guard)
ENABLE_MICRO_AFFECT="false"            # false | true (Behavioral friction detection)

# Phone Hands-Free Profile (opt-in — PipeWire + BlueZ HFP for desktop call audio)
ENABLE_PHONE_HFP="false"            # false | true (make/receive phone calls from desktop)
