# ============================================================================
# macubuntu Hardware Profile — 8 GB System RAM (ram_tier=8gb)
# OS kernel tuning, ZRAM, cgroup, and Celina subsystem knobs for 8 GB hosts.
# Sourced by stages via: source "profiles/$(jq -r .ram_tier /etc/macubuntu/hardware.json).env"
# ============================================================================

# ZRAM size expression (evaluated by stage-35 against detected RAM_MB)
# 8 GB: ZRAM = 100% of RAM (~8 GB)
ZRAM_SIZE_EXPR="ram"

# VM sysctl (byte-capped writebacks — no percentage dirty_ratio)
SWAPPINESS=160
VFS_CACHE_PRESSURE=100
DIRTY_BG_BYTES=67108864        # 64 MB
DIRTY_BYTES=201326592          # 192 MB
VM_PAGE_CLUSTER=0
VM_DIRTY_WRITEBACK_CENTISECS=200

# MGLRU working-set protection
MGLRU_MIN_TTL_MS=1000

# vmtouch pinning cap (MB) — GNOME Shell + core libs only
VMTOUCH_MAX_MB=128

# celina-ai.slice cgroup ceilings
CELINA_SLICE_HIGH="3500M"
CELINA_SLICE_MAX="4200M"
CELINA_CPU_WEIGHT=35
CELINA_IO_WEIGHT=40

# Blur My Shell / compositor glass settings
BLUR_SIGMA=12
BLUR_APPGRID=false

# llama-server Router Mode preset (see celina/llm/preset_generator.py)
LLM_MODELS_MAX=1
LLM_SLEEP_IDLE_SECONDS=120
LLM_PARALLEL_SLOTS=1
LLM_KV_CACHE_TYPE="q8_0"
LLM_CTX_DEFAULT=8192

# Celina tier policy flags
SERIALIZE_HEAVY_MODELS=true
ENABLE_LADYBUG_GRAPH=false
ENABLE_GLINER_SLOTS=false
KEEP_VOICE_HOT=false
ENABLE_ASTRA_1FPS_BUFFER=false
ENABLE_LIBKRUN_SANDBOX=false
SPOTLIGHT_BATCH_SIZE=2
RAM_PSI_EVICT_THRESHOLD=15.0

# Celina tier-adaptive context compression (8 GB: deterministic only, 0 MB ML RAM)
CELINA_COMPRESSION_TIER="8gb"
CELINA_HEADROOM_ML="0"
