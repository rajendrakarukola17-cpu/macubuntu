# Profile: power-user (16GB+ RAM workstations — Full macOS + Celina AI + LocalSearch + Dash-to-Dock)
ENABLE_CELINA="true"
CELINA_NAME="Celina"
CELINA_NICKNAME="Celly"

# UI & Launcher
DOCK_CHOICE="dash-to-dock"
LAUNCHER_CHOICE="celina-spotlight"
ENABLE_DESKTOP_ICONS="true"
ENABLE_DYNAMIC_ISLAND_EXT="false"
TOP_PANEL_STYLE="transparent"       # transparent (zero black line) | hidden (completely remove top bar) | glass
ANIMATION_SPEED="fast"              # fast (0.6x snappy) | normal (1.0x) | instant

# System Tuning
SEARCH_BACKEND="gnome-indexer"      # Full LocalSearch/Tracker3 + Recoll indexing
POWER_BACKEND="ppd"
POINTER_ACCEL="flat"
FONT_AA="rgba"
ENABLE_WAYLAND_FRACTIONAL_SCALING="true"
ENABLE_BATTERY_CHARGE_LIMIT="true"
ENABLE_VAAPI_GPU_DECODE="true"
ENABLE_CLIPBOARD_HISTORY="true"
ENABLE_DYNAMIC_APPEARANCE="true"    # Auto Light <-> Dark solar appearance switching
ENABLE_SAFARI_FIREFOX="true"        # macOS Safari UI + Safari compass icon for Firefox
ENABLE_PERSISTENT_CONTINUITY_CAM="true"
ENABLE_PRO_AUDIO_BLUETOOTH="true"
ENABLE_SAFE_SLEEP="true"
ENABLE_SILENT_BOOT="false"          # Opt-in flicker-free GRUB boot drop-in (--silent-boot)

# All-System Continuity & macOS-Parity Hub (full power-user stack)
ENABLE_AIRPLAY_VIDEO="true"
ENABLE_ANDROID_MIRROR="true"
ENABLE_SYNCTHING="true"
ENABLE_UNIVERSAL_CONTROL="true"
ENABLE_FLATSEAL="true"
ENABLE_KEEPASSXC="true"
ENABLE_NAUTILUS_QUICK_ACTIONS="true"
ENABLE_DISTROBOX="true"             # Linux subsystem containers enabled on 16GB+ workstations
ENABLE_BIOMETRICS="false"           # Explicitly flip true after checking Stage 55 capability report

# Optional Extras (still opt-in; flip to true if you want unreviewed third-party/Rust builds)
ENABLE_MACOS_CMD_KEYS="false"
INSTALL_THIRDPARTY="false"
INSTALL_RUST_TOOLS="false"
