# ============================================================================
# macubuntu Hardware Profile — 32 GB+ System RAM (ram_tier=32gb)
# OS kernel tuning, ZRAM, cgroup, and Celina subsystem knobs for 32 GB+ hosts.
# Sourced by stages via: source "profiles/$(jq -r .ram_tier /etc/macubuntu/hardware.json).env"
# ============================================================================

# ZRAM size expression (evaluated by stage-35 against detected RAM_MB)
# 32 GB+: ZRAM = min(ram / 4, 8192 MB) — capped at 8 GB
ZRAM_SIZE_EXPR="min(ram / 4, 8192)"

# VM sysctl (byte-capped writebacks — no percentage dirty_ratio)
SWAPPINESS=60
VFS_CACHE_PRESSURE=50
DIRTY_BG_BYTES=268435456       # 256 MB
DIRTY_BYTES=536870912          # 512 MB
VM_PAGE_CLUSTER=0
VM_DIRTY_WRITEBACK_CENTISECS=200

# MGLRU working-set protection (0 = unneeded on 32 GB+)
MGLRU_MIN_TTL_MS=0

# vmtouch pinning cap (MB) — keep hot apps & indexes resident
VMTOUCH_MAX_MB=1536

# celina-ai.slice cgroup ceilings
CELINA_SLICE_HIGH="18G"
CELINA_SLICE_MAX="24G"
CELINA_CPU_WEIGHT=70
CELINA_IO_WEIGHT=40

# Blur My Shell / compositor glass settings
BLUR_SIGMA=35
BLUR_APPGRID=true

# llama-server Router Mode preset (see celina/llm/preset_generator.py)
LLM_MODELS_MAX=3
LLM_SLEEP_IDLE_SECONDS=900
LLM_PARALLEL_SLOTS=4
LLM_KV_CACHE_TYPE="f16"
LLM_CTX_DEFAULT=32768

# Celina tier policy flags
SERIALIZE_HEAVY_MODELS=false
ENABLE_LADYBUG_GRAPH=true
ENABLE_GLINER_SLOTS=true
KEEP_VOICE_HOT=true
ENABLE_ASTRA_1FPS_BUFFER=true
ENABLE_LIBKRUN_SANDBOX=true
SPOTLIGHT_BATCH_SIZE=24
RAM_PSI_EVICT_THRESHOLD=35.0

# Celina tier-adaptive context compression (32 GB: workstation, ML Kompress on by default)
CELINA_COMPRESSION_TIER="32gb"
CELINA_HEADROOM_ML="1"
