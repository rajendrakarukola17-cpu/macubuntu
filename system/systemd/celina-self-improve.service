[Unit]
Description=Celina v5 Guarded Nightly Self-Improvement Proposal Generator (PCEC Loop)
Documentation=file:///usr/share/macubuntu/ARCHITECTURE.md
After=celina-autonomy.service

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -c 'VENV="${HOME}/.local/share/celina/venv/bin/python3"; [ -x "$VENV" ] || VENV=python3; PYTHONPATH="${HOME}/.local/share/celina/app:/usr/share/macubuntu/features/celina" exec "$VENV" -m celina_pkg.learning.self_improve'

NoNewPrivileges=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

MemoryHigh=128M
MemoryMax=256M
CPUQuota=15%
