[Unit]
Description=Celina v5 Autonomy Engine (Durable SQLite TaskGraph Worker)
Documentation=file:///usr/share/macubuntu/ARCHITECTURE.md
After=celina.service celina-eventd.service
Wants=celina.service celina-eventd.service
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Default safe 48h burn-in: plans & logs simulated Tier-2 receipts without executing Tier-2 tools.
# Override via drop-in (`Environment=CELINA_AUTONOMY_OBSERVE_ONLY=0`) after reviewing evidence.
Environment=CELINA_AUTONOMY_OBSERVE_ONLY=1
ExecStart=/bin/sh -c 'exec "${HOME}/.local/bin/celina-autonomy"'
Restart=on-failure
RestartSec=5s

# Hardened userns-free unprivileged directives (Ubuntu 26.04 --user safe).
# For mount-namespace ProtectSystem/PrivateTmp isolation, opt into celina-strict-fs.conf drop-in.
NoNewPrivileges=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

MemoryHigh=128M
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=default.target
