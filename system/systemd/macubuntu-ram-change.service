[Unit]
Description=macubuntu Boot-Time RAM Change Detector
Documentation=file:///usr/share/macubuntu/tools/macubuntu-ram-change-detector
After=macubuntu-hw-probe.service systemd-hwdb-update.service
Before=display-manager.service graphical-session.target
Wants=macubuntu-hw-probe.service

[Service]
Type=oneshot
ExecStart=/usr/share/macubuntu/tools/macubuntu-ram-change-detector
RemainAfterExit=yes
# Run as root so it can read /etc/macubuntu/hardware.json and invoke sudo-free reconfigure
User=root
Group=root
# Fail-closed: detector failure must not block boot
ExecStartPost=/bin/true
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
