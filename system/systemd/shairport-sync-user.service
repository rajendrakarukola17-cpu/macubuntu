[Unit]
Description=Shairport Sync AirPlay receiver (user session)
After=network-online.target pipewire.service pipewire-pulse.service avahi-daemon.service

[Service]
ExecStart=/usr/bin/shairport-sync -o @AUDIO_BACKEND@ -a "%H AirPlay"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
