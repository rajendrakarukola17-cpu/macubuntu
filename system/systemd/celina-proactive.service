[Unit]
Description=Celina v5 Proactive World-Model Daemon (eBPF Event Consumer -> Safe Rules)
Documentation=file:///usr/share/macubuntu/ARCHITECTURE.md
After=celina.service celina-eventd.service
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -c 'exec "${HOME}/.local/bin/celina-proactive"'
Restart=on-failure
RestartSec=3s

# Hardened userns-free unprivileged directives (AF_UNIX only: local event stream + session D-Bus)
NoNewPrivileges=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

MemoryHigh=32M
MemoryMax=64M
CPUQuota=5%

[Install]
WantedBy=default.target
