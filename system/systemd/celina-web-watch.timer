[Unit]
Description=Run Celina Active Web Watching periodically
Documentation=file:///usr/share/macubuntu/celina/tools/web_watch.py
Requires=network-online.target
After=network-online.target

[Timer]
# Default: every 2 hours. Override per-machine via /etc/systemd/system/
# celina-web-watch.timer.d/override.conf if desired.
OnBootSec=5min
OnUnitActiveSec=2h
# AC-power gating lives in celina-web-watch@.service [Unit] (ConditionACPower),
# where it is evaluated when the service is activated — not valid in [Timer].
Persistent=true
# If the machine was off at the scheduled time, run soon after boot.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
