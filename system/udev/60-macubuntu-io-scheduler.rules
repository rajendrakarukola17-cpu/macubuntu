# macubuntu low-latency I/O scheduler rules (prevents background reads/writes freezing desktop apps)
# NVMe SSDs: 'none' bypasses redundant software queues (NVMe has native multi-queue hardware)
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="none"
# SATA/SAS SSDs (non-rotational): 'mq-deadline' delivers crisp low-latency foreground I/O
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# Rotational HDDs: 'bfq' keeps interactive apps responsive during heavy disk transfers
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
