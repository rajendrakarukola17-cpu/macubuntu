# Snapper config for macubuntu root subvolume (@)
# APFS-style Copy-on-Write snapshots for instant system rollback
# Copy to /etc/snapper/configs/root and adjust SUBVOLUME if your layout differs

# Subvolume to snapshot
SUBVOLUME="/"

# Filesystem type
FSTYPE="btrfs"

# Snapshot limits
NUMBER_LIMIT="2-10"
NUMBER_LIMIT_IMPORTANT="4-10"

# Timeline limits (time-based snapshots)
TIMELINE_CREATE="yes"
TIMELINE_LIMIT_HOURLY="2-4"
TIMELINE_LIMIT_DAILY="2-7"
TIMELINE_LIMIT_WEEKLY="2-4"
TIMELINE_LIMIT_MONTHLY="2-1"
TIMELINE_LIMIT_YEARLY="0"
TIMELINE_LIMIT_CLEANUP="no"

# Pre/Post plugin (for apt and stage pre/post hooks)
SYNC_ACL="no"

# Quota group (optional, for btrfs qgroup tracking)
QGROUP="1/0"

# Cleanup algorithm
NUMBER_CLEANUP="number"
TIMELINE_CLEANUP="timeline"

# Empty pre/post cleanup
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1440"

# NFS export (not used)
NFS_EXPORT="no"
