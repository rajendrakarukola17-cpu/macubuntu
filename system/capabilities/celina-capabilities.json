    "/home/$USER/.local/share/keyrings",
    "/home/$USER/.mozilla",
    "/home/$USER/.password-store",
    "/home/$USER/.docker/config.json",
    "/home/$USER/.config/gh/hosts.yml",
    "/home/$USER/.celina/models",
