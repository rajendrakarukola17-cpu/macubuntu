# Celina AI Configuration (v4.4 — Default: Celina / Nickname: Celly)
# Stored at ~/.config/celina/env (permissions 600)

# --- Assistant Identity (update anytime here, in neural-schema.json, or via '/name NewName Nick') ---
CELINA_NAME="Celina"
CELINA_NICKNAME="Celly"

# --- Task-aware Cloud Brain (configure any combination; credentials are never displayed) ---
# Optional free-tier compatible providers. Configure keys in ~/.ai-env (chmod 600).
GROQ_API_KEY=""
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
MISTRAL_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY="PASTE_YOUR_KEY_HERE"
# Additional free-tier providers (Update 18):
XAI_API_KEY=""              # xAI Grok (grok-3-mini, grok-3) — reasoning, real-time data
ZHIPUAI_API_KEY=""          # Zhipu AI GLM (glm-4, glm-4v) — Chinese/English bilingual, vision
DEEPSEEK_API_KEY=""         # DeepSeek (deepseek-chat, deepseek-coder) — code, math, reasoning
TOGETHER_API_KEY=""         # Together AI (mixtral-8x7b, llama-3.1-8b) — open models, cheap
PERPLEXITY_API_KEY=""       # Perplexity (sonar-small, sonar-reasoning) — web search, current info
# Optional model overrides:
# CELINA_GROQ_MODEL="llama-3.3-70b-versatile"
# CELINA_GEMINI_MODEL="gemini-2.5-flash"
# CELINA_NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
# CELINA_MISTRAL_MODEL="mistral-small-latest"
# CELINA_CEREBRAS_MODEL="llama-3.3-70b"
# CELINA_OPENROUTER_MODEL="openrouter/free"
# CELINA_XAI_MODEL="grok-3-mini"
# CELINA_GLM_MODEL="glm-4"
# CELINA_DEEPSEEK_MODEL="deepseek-chat"
# CELINA_TOGETHER_MODEL="meta-llama/Llama-3.1-8b-Instruct-Turbo"
# CELINA_PERPLEXITY_MODEL="sonar-small"
# Optional provider order override (comma-separated provider IDs)
# CELINA_PROVIDER_ORDER="groq,cerebras,gemini,mistral,nvidia,openrouter,xai,glm,deepseek,together,perplexity"
# Optional ensemble mode (task decomposition + parallel providers)
# CELINA_ENSEMBLE="1"
CELINA_CLOUD_MODEL="openrouter/free"
# Optional vision model for Astra screenshot mode (only used when you explicitly approve!)
CELINA_VISION_MODEL="openrouter/free"

# --- Local Offline Brain (Ollama, 8GB anti-thrash tuned with dynamic keep_alive & q8_0 KV-cache) ---
OLLAMA_API_BASE="http://localhost:11434"
CELINA_LOCAL_MODEL="qwen3:1.7b"
CELINA_OLLAMA_KEEP_ALIVE="45s"
CELINA_OLLAMA_NUM_CTX="4096"

# --- Privacy Firewall, Smart Cache & Edge Lighting ---
CELINA_STRICT_PRIVACY="1"
CELINA_CACHE_ENABLED="1"
CELINA_EDGE_LIGHTING="1"

# --- Multilingual Settings (auto | en | te | hi) ---
CELINA_LANGUAGE="auto"
CELINA_SPEAK="1"
CELINA_VOICE_EN="en_US-amy-medium"
CELINA_VOICE_TE="te_IN-maya-medium"
CELINA_VOICE_HI="hi_IN-priyamvada-medium"

# --- Voice Recognition & Audio Pipeline (Silero VAD v5 ONNX, PipeWire Ducking, Piper/Kokoro TTS) ---
# 'base' is ~2.5x faster on CPU; switch to 'small' for higher Telugu/Hindi accuracy
CELINA_WHISPER_MODEL="base"
CELINA_WHISPER_IDLE_OFFLOAD="180"
# auto (uses Silero VAD v5 ONNX if ~/.local/share/celina/voices/silero_vad.onnx exists, else RMS) | silero | rms
CELINA_VAD_ENGINE="auto"
# Automatically lower background music/video volume while Celina listens/speaks, then restore cleanly (1=on)
CELINA_AUDIO_DUCKING="1"
CELINA_AUDIO_DUCK_PCT="25"
# auto (Piper default; uses Kokoro-82M ONNX for EN/HI if installed, always Piper for Telugu) | piper | kokoro
CELINA_TTS_ENGINE="auto"
CELINA_WAKE_WORD="0"
# Siri-style 5-second hands-free follow-up mic window after voice replies (1=on, 0=off)
CELINA_VOICE_FOLLOWUP="1"
# Optional custom openWakeWord .onnx model path (e.g. ~/.local/share/celina/wakeword/hey_celina.onnx)
# CELINA_WAKE_MODEL=""

# --- macOS OS Daemon Features (celina-eventd.service) ---
# Auto Light <-> Dark appearance at sunrise/sunset (0=manual, 1=auto solar)
CELINA_DYNAMIC_APPEARANCE="0"
# Opt-in cgroup v2 Auto App Nap for long-occluded background apps (0=off, 1=on)
CELINA_AUTO_APP_NAP="0"

# --- Hybrid Semantic & Embedding Engine (Zero-Idle-RAM EN/TE/HI RRF Search) ---
# auto (Model2Vec if installed, else Ollama embeddinggemma, else instant BM25 fallback) | ollama | model2vec | off
CELINA_EMBED_ENGINE="auto"
# Multilingual Ollama embedding model (run `ollama pull embeddinggemma` or `ollama pull qwen3-embedding:0.6b`)
CELINA_EMBED_MODEL="embeddinggemma"
# Optional static CPU Model2Vec model (~6,700 chunks/s if `model2vec` package is installed)
# CELINA_EMBED_MODEL2VEC="minishlab/potion-multilingual-128M"
# Matryoshka truncated vector dimension (256d float16 = 512 bytes/item) & RRF fusion constant
CELINA_EMBED_DIM="256"
CELINA_EMBED_KEEP_ALIVE="30s"
# CELINA_EMBED_RRF_K="60"
# CELINA_TOOL_SEMANTIC_MIN_SIM="0.34"
# Paraphrase semantic response caching (cosine >= 0.92, non-private prompts only, language-partitioned)
CELINA_SEMANTIC_CACHE="1"
CELINA_SEMANTIC_CACHE_THRESHOLD="0.92"
# Advanced tuning (auto-detected by default):
# CELINA_OLLAMA_NUM_THREADS="4"
# CELINA_OCR_LANGUAGES="eng+tel+hin"
# CELINA_ACTION_GATE="1"

# --- Optional Remote MCP Connector Tokens (only needed if enabled in ~/.config/celina/mcp-servers.json) ---
# GITHUB_TOKEN=""
# LINEAR_API_KEY=""
# NOTION_TOKEN=""
